{
  "name": "dsh-snapshot-manager",
  "version": "0.3.0",
  "private": false,
  "description": "会话快照 / 回滚（DeepSeek Harness 插件）：按轮次采集工作区快照，一键把文件与对话回退到某一轮之前。",
  "type": "module",
  "main": "lib/host.js",
  "scripts": {
    "test": "node test/chain.test.mjs && node test/restore.test.mjs && node test/journal.test.mjs && node test/rel-path.test.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/985451842/dsh-snapshot-manager.git"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "snapshot",
    "rollback"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ]
}
